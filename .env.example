# Root .env.example - Copy to .env and fill in values

# Server Configuration
PORT=3002
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:4173

# JWT Configuration (CHANGE IN PRODUCTION - use strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Admin Credentials (used by seed script to create first admin)
ADMIN_EMAIL=admin@kdkangenwater.com
ADMIN_PASSWORD=ChangeMe123!

# Database
DATABASE_PATH=./server/data/kangen.db

# File Upload
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE=10485760

# Cloudinary (optional - for cloud storage instead of local)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional - for contact form notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@kdkangenwater.com
CONTACT_EMAIL=info@kdkangenwater.com